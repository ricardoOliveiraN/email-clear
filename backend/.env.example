# Copie para `backend/.env` para rodar o backend LOCALMENTE (venv + uvicorn).
# Nunca commitar `.env` (ver .gitignore).

# Conexão com o PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://emailclear:emailclear@localhost:5432/emailclear

# Segredo para assinar tokens de instalação (ADR-0014). Gere um valor aleatório longo.
INSTALL_TOKEN_SECRET=dev-secret-change-me

# OpenRouter (IA de conteúdo — ADR-0007). Deixe vazio para degradar para heurísticas.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Google Safe Browsing (validação de links — ADR-0007). Vazio = sem lookup (links "unknown").
SAFEBROWSING_API_KEY=

# TTL do cache L2 por hash de conteúdo (ADR-0015), em segundos
CACHE_TTL_SECONDS=86400
