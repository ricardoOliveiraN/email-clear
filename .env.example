# Copie para `.env` na RAIZ do repositório para usar com `docker compose`.
# O docker compose injeta estas variáveis no container do backend.

# Segredo para assinar tokens de instalação (ADR-0014). Gere um valor aleatório longo.
INSTALL_TOKEN_SECRET=dev-secret-change-me

# OpenRouter (IA de conteúdo — ADR-0007). Deixe vazio para degradar para heurísticas.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Google Safe Browsing (validação de links — ADR-0007). Vazio = sem lookup (links "unknown").
SAFEBROWSING_API_KEY=
